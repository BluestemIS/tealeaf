# Copy to harness.toml and edit. Env vars override: LLMH_BASE_URL, LLMH_MODEL, LLMH_API_KEY,
# LLMH_JUDGE_BASE_URL, LLMH_JUDGE_MODEL, LLMH_DB, LLMH_OPIK_ENABLED, ...

# SQLite file, relative to this config file.
db_path = "data/harness.db"

[target]
# Any OpenAI-compatible server:
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
#   llama.cpp  http://localhost:8080/v1
#   vLLM/MLX   http://<host>:8000/v1
base_url = "http://localhost:11434/v1"
model = ""            # empty = first model the server lists
api_key = ""
temperature = 0.7     # default; many cases override (e.g. 0 for scored answers, 1.0 for randomness)
max_tokens = 2048     # raise for reasoning models that think at length
timeout = 300
stream = true         # streaming gives time-to-first-token and live tokens in the dashboard
# extra = { top_p = 0.9 }   # merged into every request body (e.g. num_ctx for some servers)

# Optional: a separate (ideally stronger) model that grades open-ended answers, annotates probes,
# and plays the interlocutor in conversations. Omit this section to have the target judge itself.
# [judge]
# base_url = "http://localhost:11434/v1"
# model = "qwen2.5:32b"

[run]
concurrency = 1                  # >1 skews performance numbers on single-GPU servers
case_timeout = 900
samples = 10                     # repetitions for randomness/consistency probes
conversation_turns = 6           # turns per judge-driven conversation
long_context_max_tokens = 8000   # needle-in-haystack max length (1k, 4k, 8k, 16k, 32k up to this)
annotate = true                  # judge annotates probe transcripts with interest score + beliefs
allow_code_execution = true      # coding suite runs model-written Python in a subprocess

[opik]
enabled = false                  # or pass --opik
url = "http://opik.home.lan/api"
project = "llm-test-harness"
workspace = "default"
