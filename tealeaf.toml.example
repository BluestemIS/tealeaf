# Copy to tealeaf.toml and edit. Env vars override: TEALEAF_BASE_URL, TEALEAF_MODEL, TEALEAF_API_KEY,
# TEALEAF_JUDGE_BASE_URL, TEALEAF_JUDGE_MODEL, TEALEAF_DB, TEALEAF_OPIK_ENABLED, ...

# SQLite file, relative to this config file.
db_path = "data/harness.db"

[target]
# Any OpenAI-compatible server:
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
#   llama.cpp  http://localhost:8080/v1
#   vLLM/MLX   http://<host>:8000/v1
base_url = "http://localhost:11434/v1"
model = ""            # empty = first model the server lists
api_key = ""          # or TEALEAF_API_KEY, --api-key-env VAR, or the dashboard's API key box
temperature = 0.7     # default; many cases override (e.g. 0 for scored answers, 1.0 for randomness)
max_tokens = 8192     # reasoning models think first; too low and replies come back empty
timeout = 300
stream = true         # streaming gives time-to-first-token and live tokens in the dashboard
logprobs = true       # ask for token probabilities (vLLM, llama.cpp...; ignored by servers without them)
top_logprobs = 5      # alternatives kept per answer token (max 20)
# extra = { top_p = 0.9 }   # merged into every request body (e.g. num_ctx for some servers)

# Optional: a separate (ideally stronger) model that grades open-ended answers, annotates probes,
# and plays the interlocutor in conversations. Omit this section to have the target judge itself.
# Fields you leave out are copied from [target]. Put API keys in TEALEAF_JUDGE_API_KEY, not this file.
# [judge]
# base_url = "http://localhost:11434/v1"
# model = "qwen2.5:32b"
#
# Hosted judge through OpenRouter (export TEALEAF_JUDGE_API_KEY=sk-or-...):
# [judge]
# base_url = "https://openrouter.ai/api/v1"
# model = "anthropic/claude-sonnet-5.5"   # or anthropic/claude-opus-5.5, anthropic/claude-haiku-5.5, openai/...
# send_temperature = false                 # current Claude and GPT-5 models don't accept temperature
# stream = false                           # judge output isn't shown live; simpler over the internet
# max_tokens = 4096

[run]
concurrency = 1                  # >1 skews performance numbers on single-GPU servers
case_timeout = 900
samples = 10                     # repetitions for randomness/consistency probes
conversation_turns = 6           # turns per judge-driven conversation
long_context_max_tokens = 8000   # needle-in-haystack max length (1k, 4k, 8k, 16k, 32k up to this)
annotate = true                  # judge annotates probe transcripts with interest score + beliefs
allow_code_execution = true      # coding suite runs model-written Python in a subprocess
# system_prompt = "You are a helpful assistant deployed by Acme Corp."
#                                  # put at the start of every conversation with the target (ahead of a
#                                  # case's own system prompt); the judge never sees it. --system overrides.

[web]
host = "127.0.0.1"               # "0.0.0.0" = all interfaces. No authentication, and the dashboard can start
port = 8765                      # runs (incl. executing model-written code): only on networks you trust.
# allowed_hosts = ["tealeaf.lan"] # extra host names it answers to (localhost, IPs and this machine's name
#                                 # always work); others are refused, which blocks DNS rebinding

[opik]
enabled = false                  # or pass --opik
url = "http://opik.home.lan/api"
project = "tealeaf"
workspace = "default"

[steer]
# `tealeaf steer-agent` on the llama.cpp machine; see "Steering vectors" in the README.
# agent_url = "http://gpuserver:8766"   # token: TEALEAF_STEER_TOKEN
# scales = [-1.5, -0.75, 0, 0.75, 1.5] # strengths to sweep; 0 = unsteered
